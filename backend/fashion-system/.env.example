
# Cấu hình kết nối PostgreSQL cho ứng dụng Fashion System.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commerce_db
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Hibernate chỉ kiểm tra schema, không tự ý thay đổi cấu trúc bảng.
JPA_DDL_AUTO=validate
SHOW_SQL=false

# Redis read cache. Local có thể dùng Redis Docker ở localhost:6379.
# Giữ disabled nếu local chưa chạy Redis; API READ vẫn dùng PostgreSQL.
REDIS_CACHE_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_READ_TIMEOUT_MS=500
REDIS_KEY_PREFIX=fs:local:v1:
REDIS_CACHE_DEFAULT_TTL=5m
REDIS_CACHE_ACTIVE_MODULES_TTL=10m
REDIS_CACHE_AUTHORIZATION_CATALOG_TTL=5m
REDIS_CACHE_AUTHORIZATION_ROLE_TTL=2m
REDIS_CACHE_AUTHORIZATION_EFFECTIVE_PERMISSION_TTL=30s
REDIS_CACHE_AUTHORIZATION_USER_ASSIGNMENT_TTL=1m
REDIS_CACHE_WARNING_INTERVAL=30s
REDIS_CACHE_SCAN_BATCH_SIZE=1000

# JWT secret Base64 tối thiểu 256 bit; không dùng giá trị ví dụ ở production.
JWT_SECRET=replace_with_base64_secret
JWT_EXPIRATION_MS=3600000
AUTH_MAX_FAILED_ATTEMPTS=5

# SMTP. Với Gmail, MAIL_PASSWORD là App Password, không phải mật khẩu đăng nhập.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM_ADDRESS=your_email@example.com
MAIL_FROM_NAME=Fashion System
MAIL_OTP_SUBJECT=Ma OTP dat lai mat khau
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# Cấu hình luồng quên mật khẩu.
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=10
PASSWORD_RESET_MAX_OTP_ATTEMPTS=5

# Social login cho customer. App secret Facebook chỉ được đặt ở backend.
GOOGLE_CLIENT_ID=
GOOGLE_ISSUER_URI=https://accounts.google.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_VERSION=

# =========================================================
# PAYMENT GATEWAY
# Dùng chung cho VNPay, MoMo, Stripe hoặc cổng thanh toán khác.
# Chỉ điền các trường mà provider đã chọn yêu cầu.
# =========================================================
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_CLIENT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_SIGNING_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_WEBHOOK_URL=
PAYMENT_CURRENCY=VND
PAYMENT_TIMEOUT_SECONDS=30

# =========================================================
# THIRD-PARTY SHIPPING / DELIVERY
# Dùng chung cho GHN, GHTK, Viettel Post hoặc provider khác.
# =========================================================
SHIPPING_ENABLED=false
SHIPPING_PROVIDER=
SHIPPING_API_BASE_URL=
SHIPPING_API_TOKEN=
SHIPPING_CLIENT_ID=
SHIPPING_CLIENT_SECRET=
SHIPPING_SHOP_ID=
SHIPPING_WEBHOOK_SECRET=
SHIPPING_WEBHOOK_URL=
SHIPPING_TIMEOUT_SECONDS=30

# Thông tin kho gửi mặc định; có thể chuyển sang bảng stores khi triển khai nghiệp vụ.
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_PHONE=
SHIPPING_SENDER_ADDRESS=
SHIPPING_SENDER_PROVINCE=
SHIPPING_SENDER_DISTRICT=
SHIPPING_SENDER_WARD=

# =========================================================
# AI CHATBOT
# AI_PROVIDER nhận OPENAI hoặc ANTHROPIC. API key chỉ đặt ở backend.
# Tên model để trống cho đến khi chọn model được tài khoản cấp quyền.
# =========================================================
AI_CHATBOT_ENABLED=false
AI_PROVIDER=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.3

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=
