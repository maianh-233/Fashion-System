# URL backend chỉ dùng bởi Vite dev server để proxy các request /api.
# Không có dấu / ở cuối URL.
BACKEND_URL=http://localhost:8080

# Để trống khi frontend và backend được phục vụ cùng origin hoặc khi chạy local
# qua Vite proxy. Khi deploy khác origin, nhập URL public của backend, ví dụ:
# VITE_API_BASE_URL=https://api.lunaria.example
VITE_API_BASE_URL=
