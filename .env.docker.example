# Cấu hình cho docker-compose.yml. Sao chép thành .env ở thư mục gốc (đã được gitignore):
#   cp .env.docker.example .env

# Bắt buộc. JWT secret Base64 >= 256 bit, tạo bằng:
#   openssl rand -base64 48
JWT_SECRET=

# Bắt buộc. Tài khoản SUPER_ADMIN tạo khi database còn trống; đổi mật khẩu sau khi đăng nhập.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=

# Database trong container Postgres (chỉ cần đổi nếu muốn).
DB_NAME=commerce_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Cổng trên máy host.
FRONTEND_PORT=8081
BACKEND_PORT=8080
POSTGRES_PORT=5433

API_DOCS_ENABLED=true

# Tùy chọn: Google Sign-In (được build vào frontend), email, Cloudinary, thanh toán,
# giao hàng... Tên biến giống backend/fashion-system/.env.example.
# VITE_GOOGLE_CLIENT_ID=
# MAIL_HOST=
# CLOUDINARY_CLOUD_NAME=
# VNPAY_TMN_CODE=
